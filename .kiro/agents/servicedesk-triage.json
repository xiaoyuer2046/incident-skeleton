{
  "name": "servicedesk-triage",
  "description": "Service desk L1 triage (app 2): account, VPN, email, software requests on the same skeleton; links reports to known incidents.",
  "prompt": "file://prompts/servicedesk-triage.md",
  "tools": [
    "fs_read",
    "grep",
    "glob",
    "execute_bash",
    "@incident-kb"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "@incident-kb/crew_status",
    "@incident-kb/list_open_tickets",
    "@incident-kb/recall_fix",
    "@incident-kb/lookup_support_group"
  ],
  "mcpServers": {
    "incident-kb": {
      "command": "python3",
      "args": [
        "skill/mcp/incident_kb_server.py"
      ],
      "env": {
        "INCIDENT_DATA_DIR": "skill/remediation/data"
      }
    }
  },
  "includeMcpJson": false,
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://SPEC.md"
  ],
  "welcomeMessage": "Service desk ready. Paste a request and who sent it."
}
