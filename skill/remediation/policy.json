  "promote_min_rate": 0.67,
  "demote_min_attempts": 3,
  "demote_max_rate": 0.2
 },
 "escalation": {
  "enabled": true,
  "dry_run": true,
  "groups": {
   "printer": "Print Services",
   "signage": "AV / Digital Signage",
   "av": "Meeting Rooms / AV",
   "wifiap": "Network / Wireless",
   "upstream": "Network / LAN"
  }
 },
 "patrol": {
  "rounds": 3,
  "need": 2,
  "interval_minutes": 10
 },
 "blast_radius": {
  "min_devices": 3,
