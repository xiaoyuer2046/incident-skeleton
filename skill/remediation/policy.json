{
 "_comment": "The permission model. Change this file to give the crew more or less authority. Nothing here is hidden in code.",
 "mode": "dry-run",
 "autonomy": {
  "low": "auto",
  "medium": "notify_then_act",
  "high": "approval"
 },
 "allow": {
  "printer": [
   "restart-spooler",
   "clear-queue",
   "readd-queue"
  ],
  "signage": [
   "repush-content",
   "reboot-player",
   "clear-player-cache"
  ],
  "av": [
   "restart-room-app",
   "reboot-codec",
   "reboot-controller",
   "reset-room-profile"
  ],
  "wifiap": [
   "controller-reboot-ap",
   "poe-cycle",
   "rf-tune"
  ]
 },
