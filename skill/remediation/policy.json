{
 "_comment": "The permission model. Change this file to give the crew more or less authority. Nothing here is hidden in code.",
 "mode": "dry-run",
 "autonomy": {
  "low": "auto",
  "medium": "notify_then_act",
  "high": "approval"
 },
 "allow": {
  "printer": [
   "restart-spooler",
   "clear-queue",
   "readd-queue"
  ],
  "signage": [
   "repush-content",
   "reboot-player",
   "clear-player-cache"
  ],
  "av": [
   "restart-room-app",
   "reboot-codec",
   "reboot-controller",
   "reset-room-profile"
  ],
  "wifiap": [
   "controller-reboot-ap",
   "poe-cycle",
   "rf-tune"
  ]
 },
 "max_attempts_per_incident": 4,
 "cooldown_minutes": 30,
 "notify_wait_seconds": 0,
 "evolution": {
  "promote_min_successes": 2,
  "promote_min_rate": 0.67,
  "demote_min_attempts": 3,
  "demote_max_rate": 0.2
 },
 "escalation": {
  "enabled": true,
  "dry_run": true,
  "groups": {
   "printer": "Print Services",
   "signage": "AV / Digital Signage",
   "av": "Meeting Rooms / AV",
   "wifiap": "Network / Wireless",
   "upstream": "Network / LAN"
  }
 },
 "patrol": {
  "rounds": 3,
  "need": 2,
  "interval_minutes": 10
 },
 "blast_radius": {
  "min_devices": 3,
  "_comment": "this many confirmed faults behind one upstream switch = one upstream ticket, no per-device repairs"
 },
 "reopen_hours": 72,
 "kill_switch": false,
 "max_repairs_per_device_per_day": 6,
 "recheck_minutes": 10,
 "notify": {
  "dry_run": true,
  "channels": [
   {
    "name": "Teams · IT on-call",
    "platform": "teams",
    "webhook_env": "TEAMS_WEBHOOK_URL",
    "kinds": "*"
   },
   {
    "name": "Slack #it-announce",
    "platform": "slack",
    "webhook_env": "SLACK_WEBHOOK_URL",
    "kinds": [
     "outage",
     "board",
     "board_closed",
     "kill"
    ]
   },
   {
    "name": "Teams · meeting organizer (DM)",
    "platform": "teams",
    "webhook_env": "TEAMS_DM_WEBHOOK_URL",
    "kinds": [
     "meeting_saved",
     "meeting_risk",
     "room_move",
     "meeting_ok_again"
    ]
   }
  ]
 },
 "premeeting": {
  "lead_minutes": 30,
  "move_minutes": 15
 },
 "kb_draft": {
  "min_confirmed": 2,
  "min_rate": 0.5
 },
 "chatops": {
  "approvers": {
   "av": [
    "Chen Wei (AV lead)"
   ],
   "wifiap": [
    "Zhang Min (Network)",
    "Ravi Kumar (Network on-call)"
   ],
   "printer": [
    "Liu Yang (Print)"
   ],
   "signage": [
    "Marco Ruiz (AV)"
   ],
   "*": [
    "liuyan"
   ]
  }
 }
}